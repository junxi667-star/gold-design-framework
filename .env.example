# 默认不需要任何 API Key。
# 以下配置只在你的 ComfyUI 地址、模型文件名或工作流路径不同的时候使用。

COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=./workflows/sdxl_base_refiner_gold_v1_api.json
COMFYUI_BASE_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_REFINER_CHECKPOINT=sd_xl_refiner_1.0.safetensors
COMFYUI_SUBMIT_TIMEOUT_MS=15000
COMFYUI_REQUEST_TIMEOUT_MS=30000

# 默认本地需求解析，不向外部传输。
AI_REQUIREMENT_PROVIDER=local
AI_ALLOW_EXTERNAL_REQUIREMENT_DATA=false

# Monad Testnet 的公开只读参数。脚本仍会硬编码校验官方 RPC 与 chainId=10143，
# 这里不能配置私钥、助记词或写操作授权令牌。
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_CHAIN_ID=10143
MONAD_TESTNET_EXPLORER_URL=https://testnet.monadscan.com
MONAD_TESTNET_FAUCET_URL=https://faucet.monad.xyz

# 可选：一次性测试账户必须保存在仓库外。默认使用当前用户 LOCALAPPDATA。
# GOLD_MONAD_TESTNET_SECRET_DIR=D:\path-outside-repository\monad-testnet
