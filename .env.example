# ============================================================
# JewelChain Studio v0.7.0
# 复制本文件并重命名为 .env，然后填写真实配置。
# 不要把 .env 上传 GitHub，也不要把 API Key 发给其他人。
# ============================================================

# 1) 火山方舟 Seedream（必填，真实生图）
ARK_API_KEY=请填写重新创建的火山方舟APIKey
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_IMAGE_SIZE=2K
ARK_IMAGE_WATERMARK=true
ARK_IMAGE_TIMEOUT_MS=180000

# 2) Monad Testnet（默认已填写，可按团队新部署合约修改）
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_EXPLORER_URL=https://testnet.monadvision.com
DESIGN_REGISTRY_ADDRESS=0x017BA6A7b6d90387bc588ad6FccDf2e0FD16D8b7

# 3) 链下存储
# auto：配置 Supabase 就使用 Supabase，否则回退本地
# local：仅保存电脑本地
# supabase：强制 Supabase，连接失败时直接报错
STORAGE_MODE=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=jewelchain-public

# 4) 公开演示保护
# 建议设置 6 位以上访问码；通过 Cloudflare 公网访问时必须填写
DEMO_ACCESS_CODE=
DEMO_GENERATION_LIMIT_PER_HOUR=10

# 5) 本地服务
PORT=4173
# 6) Master / Image Worker（v0.8.0）
# worker：Master 排队，本机 Image Worker 通过 WebSocket + HTTP 领取任务
# direct：Master 直接调用火山方舟
# hybrid：优先 Worker，无在线 Worker 时 Master 直调 API
IMAGE_EXECUTION_MODE=worker
MASTER_BASE_URL=http://127.0.0.1:4173
WORKER_ID=long-pc-image-01
WORKER_TOKEN=请设置一个至少32位的随机WorkerToken
WORKER_MAX_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_SECONDS=120
WORKER_TASK_MAX_ATTEMPTS=3
HOST=127.0.0.1

