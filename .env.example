# 默认不需要任何 API Key。
# 以下配置只在你的 ComfyUI 地址、模型文件名或工作流路径不同的时候使用。

COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=./workflows/sdxl_base_refiner_gold_v1_api.json
COMFYUI_BASE_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_REFINER_CHECKPOINT=sd_xl_refiner_1.0.safetensors
COMFYUI_SUBMIT_TIMEOUT_MS=15000
COMFYUI_REQUEST_TIMEOUT_MS=30000

# 默认本地需求解析，不向外部传输。
AI_REQUIREMENT_PROVIDER=local
AI_ALLOW_EXTERNAL_REQUIREMENT_DATA=false
